{
  "manifest_version": 3,
  "name": "Open in pullspace",
  "version": "0.1.0",
  "description": "Read the GitHub page you are on — a pull request, a file, a branch — in pullspace instead.",
  "homepage_url": "https://github.com/bigmah/pullspace",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open in pullspace",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open the current GitHub page in pullspace"
    }
  }
}
